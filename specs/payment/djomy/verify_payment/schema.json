{
  "spec_version": "1.1",
  "provider_api_version": "v1.0",
  "capability": "verify_payment",
  "capability_type": "synchronous",
  "status": "verified",
  "verification": {
    "method": "app",
    "environment": "sandbox",
    "at": "2026-04-10",
    "ref": "https://github.com/afrotools/examples/tree/main/shop",
    "spec_hash": "sha256:508f936c034ff76a9968f249cfaed4987409535f2cc2b73a840316c3bf78b6cf"
  },
  "currency": [
    "GNF"
  ],
  "auth": {
    "type": "bearer",
    "location": "header",
    "field": "Authorization",
    "format": "Bearer {access_token}",
    "env_var": "DJOMY_CLIENT_ID",
    "credentials": [
      {
        "env_var": "DJOMY_CLIENT_ID",
        "description": "clientId (API key), provided in the Djomy merchant space"
      },
      {
        "env_var": "DJOMY_CLIENT_SECRET",
        "description": "clientSecret (secret key), provided in the Djomy merchant space"
      }
    ],
    "signing": {
      "algorithm": "HMAC-SHA256",
      "key": "{DJOMY_CLIENT_SECRET}",
      "message": "{DJOMY_CLIENT_ID}",
      "encoding": "hex"
    },
    "token_exchange": {
      "method": "POST",
      "path": "/v1/auth",
      "headers": [
        {
          "in": "header",
          "name": "X-API-KEY",
          "value": "{DJOMY_CLIENT_ID}:{signature}"
        }
      ],
      "token_field": "data.accessToken",
      "expires_in_s": 3600
    },
    "apply": [
      {
        "in": "header",
        "name": "X-API-KEY",
        "value": "{DJOMY_CLIENT_ID}:{signature}"
      },
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {access_token}"
      }
    ]
  },
  "endpoint": {
    "method": "GET",
    "url": "https://sandbox-api.djomy.africa/v1/payments/{transactionId}/status"
  },
  "parameters": [
    {
      "name": "transactionId",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string"
      },
      "description": "The transactionId returned by create_payment or create_payment_gateway. Passed as a path parameter."
    }
  ],
  "example_prompt": "Add server-side Djomy payment verification to my order fulfillment flow.",
  "input_schema": {},
  "response_schema": {
    "type": "object",
    "description": "All responses are wrapped in { success, message, data, error, errors, timestamp, status }.",
    "properties": {
      "success": {
        "type": "boolean"
      },
      "message": {
        "type": "string"
      },
      "data": {
        "type": "object",
        "properties": {
          "transactionId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "PENDING",
              "FAILED",
              "SUCCESS",
              "REDIRECTED",
              "CANCELLED",
              "TIMEOUT",
              "REFUNDED"
            ],
            "description": "Use status === 'SUCCESS' as the only safe condition to fulfill an order."
          },
          "paidAmount": {
            "type": "number",
            "description": "Amount paid by the payer."
          },
          "receivedAmount": {
            "type": "number",
            "description": "Amount received by the merchant after Djomy fees."
          },
          "fees": {
            "type": "number"
          },
          "paymentMethod": {
            "type": "string"
          },
          "payerIdentifier": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "GNF",
              "FCFA",
              "Dollar",
              "Leones"
            ],
            "description": "Note: these are Djomy's internal currency strings, not ISO 4217 codes."
          },
          "merchantPaymentReference": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "providerReference": {
            "type": "string",
            "description": "Reference from the payment operator (Orange Money, Kulu, etc.)."
          },
          "allowedPaymentMethods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "fieldsErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "status": {
        "type": "integer"
      }
    }
  },
  "error_schema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean",
        "enum": [
          false
        ]
      },
      "message": {
        "type": "string"
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "fieldsErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "status": {
        "type": "integer"
      }
    }
  },
  "gotchas": [
    "Never fulfill an order until data.status === 'SUCCESS'. PENDING means payment is still in progress. CAPTURED means the amount has been collected but may differ from SUCCESS depending on the flow.",
    "receivedAmount is what you actually receive after Djomy deducts fees. Use this for your accounting, not paidAmount.",
    "The currency field returns non-ISO strings: 'GNF', 'FCFA', 'Dollar', 'Leones'. Map these to ISO 4217 codes (GNF, XOF, USD, SLE) in your system.",
    "A missing or invalid X-API-KEY returns HTTP 401 (documented as \"Clé API manquante ou invalide\")."
  ],
  "open_questions": [
    "Production base URL: Djomy's API reference lists only https://sandbox-api.djomy.africa (\"Staging environment\"). Ask the user or Djomy for the production URL — never guess it."
  ]
}
