{
  "spec_version": "1.1",
  "provider_api_version": "v1.0",
  "capability": "get_payment_link",
  "capability_type": "synchronous",
  "status": "ready",
  "currency": [
    "GNF"
  ],
  "auth": {
    "type": "bearer",
    "location": "header",
    "field": "Authorization",
    "format": "Bearer {access_token}",
    "env_var": "DJOMY_CLIENT_ID",
    "credentials": [
      {
        "env_var": "DJOMY_CLIENT_ID",
        "description": "clientId (API key), provided in the Djomy merchant space"
      },
      {
        "env_var": "DJOMY_CLIENT_SECRET",
        "description": "clientSecret (secret key), provided in the Djomy merchant space"
      }
    ],
    "signing": {
      "algorithm": "HMAC-SHA256",
      "key": "{DJOMY_CLIENT_SECRET}",
      "message": "{DJOMY_CLIENT_ID}",
      "encoding": "hex"
    },
    "token_exchange": {
      "method": "POST",
      "path": "/v1/auth",
      "headers": [
        {
          "in": "header",
          "name": "X-API-KEY",
          "value": "{DJOMY_CLIENT_ID}:{signature}"
        }
      ],
      "token_field": "data.accessToken",
      "expires_in_s": 3600
    },
    "apply": [
      {
        "in": "header",
        "name": "X-API-KEY",
        "value": "{DJOMY_CLIENT_ID}:{signature}"
      },
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {access_token}"
      }
    ]
  },
  "endpoint": {
    "method": "GET",
    "url": "https://sandbox-api.djomy.africa/v1/links/{reference}"
  },
  "parameters": [
    {
      "name": "reference",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string"
      },
      "description": "The paymentLinkReference returned by create_payment_link. Passed as a path parameter."
    }
  ],
  "example_prompt": "Add a check to see if a customer has paid via the Djomy link I sent them.",
  "input_schema": {},
  "response_schema": {
    "type": "object",
    "description": "All responses are wrapped in { success, message, data, error, errors, timestamp, status }.",
    "properties": {
      "success": {
        "type": "boolean"
      },
      "message": {
        "type": "string"
      },
      "data": {
        "type": "object",
        "properties": {
          "paymentLinkReference": {
            "type": "string",
            "description": "Reference of the payment link. Use this (not reference) for all operations."
          },
          "reference": {
            "type": "string",
            "description": "Deprecated. Use paymentLinkReference instead."
          },
          "linkName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "REVOKED",
              "PAID"
            ],
            "description": "ACTIVE = ready to receive payments. REVOKED = manually deactivated. PAID = UNIQUE link that has received one successful payment."
          },
          "usageType": {
            "type": "string",
            "enum": [
              "UNIQUE",
              "MULTIPLE"
            ]
          },
          "amountToPay": {
            "type": "number"
          },
          "countryCode": {
            "type": "string"
          },
          "merchantReference": {
            "type": "string"
          },
          "paymentPageUrl": {
            "type": "string",
            "description": "Public URL of the payment page."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "numberOfUsage": {
            "type": "integer",
            "description": "Number of successful payments received through this link."
          },
          "usageLimit": {
            "type": "integer"
          },
          "customFields": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "payments": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "List of successful payments made through this link."
          },
          "allowedPaymentMethods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "fieldsErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "status": {
        "type": "integer"
      }
    }
  },
  "error_schema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean",
        "enum": [
          false
        ]
      },
      "message": {
        "type": "string"
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "fieldsErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "status": {
        "type": "integer"
      }
    }
  },
  "gotchas": [
    "Fill the {reference} path parameter with paymentLinkReference from create_payment_link, not its deprecated `reference` field (\"Merci de considérer le champs paymentLinkReference\").",
    "A 404 is returned if the reference does not exist or belongs to a different merchant account. Check that you are using the correct credentials and the correct reference.",
    "For UNIQUE links, data.status becomes REVOKED after one successful payment — not PAID. PAID is only set in specific conditions. Use data.numberOfUsage > 0 as the reliable indicator that a UNIQUE link has been used.",
    "Pass the reference directly as a path segment — do not URL-encode it. The paymentLinkReference format contains only safe characters.",
    "A missing or invalid X-API-KEY returns HTTP 401 (documented as \"Clé API manquante ou invalide\")."
  ],
  "open_questions": [
    "Production base URL: Djomy's API reference lists only https://sandbox-api.djomy.africa (\"Staging environment\"). Ask the user or Djomy for the production URL — never guess it."
  ]
}
