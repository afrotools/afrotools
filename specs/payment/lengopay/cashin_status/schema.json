{
  "spec_version": "1.1",
  "provider_api_version": "2024-01-01",
  "capability": "cashin_status",
  "capability_type": "synchronous",
  "status": "ready",
  "currency": [
    "GNF"
  ],
  "auth": {
    "type": "api_key",
    "location": "header",
    "field": "Authorization",
    "format": "Basic {token}",
    "env_var": "LENGOPAY_LICENSE_KEY",
    "credentials": [
      {
        "env_var": "LENGOPAY_LICENSE_KEY",
        "description": "license key, sent as Authorization: Basic <license key> (the key as is, not base64 of user:password)"
      },
      {
        "env_var": "LENGOPAY_WEBSITE_ID",
        "description": "website ID of your LengoPay account, sent with the request (body field websiteid, or path segment for get_balance), separate from the license key"
      }
    ],
    "apply": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Basic {LENGOPAY_LICENSE_KEY}"
      }
    ]
  },
  "endpoint": {
    "method": "POST",
    "url": "https://portal.lengopay.com/api/v2/cashin/transaction"
  },
  "example_prompt": "Add LengoPay payment status polling to my order flow.",
  "input_schema": {
    "type": "object",
    "required": [
      "pay_id",
      "websiteid"
    ],
    "properties": {
      "pay_id": {
        "type": "string",
        "description": "Transaction identifier returned by cashin_request (base64-encoded)."
      },
      "websiteid": {
        "type": "string",
        "description": "Unique site identifier (Site ID in the LengoPay dashboard)."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "SUCCESS",
          "FAILED",
          "PENDING"
        ],
        "description": "Cash In payment status."
      },
      "pay_id": {
        "type": "string",
        "description": "Payment identifier."
      },
      "amount": {
        "type": "number",
        "description": "Payment amount."
      },
      "account": {
        "type": "string",
        "description": "Phone number of the payment recipient."
      },
      "date": {
        "type": "string",
        "description": "Transaction date (format YYYY-MM-DD HH:MM:SS)."
      }
    }
  },
  "error_schema": {
    "type": "object",
    "properties": {
      "message": {
        "type": "string",
        "description": "Error description."
      }
    }
  },
  "gotchas": [
    "Use the base64 pay_id returned by cashin_request without decoding — LengoPay expects it as is.",
    "PENDING means the payment is being processed on the mobile network. Do not treat PENDING as final — wait for SUCCESS or FAILED.",
    "Never fulfill an order on PENDING status, even after several successive checks."
  ]
}
