{
  "spec_version": "1.1",
  "provider_api_version": "2024-01-01",
  "capability": "verify_transfer",
  "capability_type": "synchronous",
  "status": "ready",
  "currency": [
    "XAF",
    "XOF",
    "KES",
    "UGX",
    "GHS"
  ],
  "auth": {
    "type": "api_key",
    "location": "header",
    "field": "Authorization",
    "format": "{token}",
    "env_var": "NOTCHPAY_PUBLIC_KEY",
    "credentials": [
      {
        "env_var": "NOTCHPAY_PUBLIC_KEY",
        "description": "Notch Pay public key, sent as is in Authorization; a key containing test_ works in sandbox (same host for test and live)"
      },
      {
        "env_var": "NOTCHPAY_PRIVATE_KEY",
        "description": "Notch Pay private key, sent as is in X-Grant, for transfers, beneficiaries, balance and webhooks"
      }
    ],
    "apply": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "{NOTCHPAY_PUBLIC_KEY}"
      },
      {
        "in": "header",
        "name": "X-Grant",
        "value": "{NOTCHPAY_PRIVATE_KEY}"
      }
    ]
  },
  "endpoint": {
    "method": "GET",
    "url": "https://api.notchpay.co/transfers/{reference}"
  },
  "example_prompt": "Check the status of a Notch Pay transfer after initiating a disbursement.",
  "input_schema": {
    "type": "object",
    "required": [],
    "properties": {}
  },
  "parameters": [
    {
      "name": "reference",
      "in": "path",
      "required": true,
      "schema": {
        "type": "string"
      },
      "description": "The transfer reference returned by send_transfer (transfer.reference)."
    }
  ],
  "response_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "Response label, e.g. \"Accepted\"."
      },
      "message": {
        "type": "string",
        "description": "Human-readable message, e.g. \"Transfer retrieved\"."
      },
      "code": {
        "type": "integer",
        "description": "HTTP-like code, 202 on success."
      },
      "transfer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Transfer status: \"pending\", \"complete\", \"failed\"."
          },
          "beneficiary": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "error_schema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "integer",
        "description": "HTTP error code (401, 404)."
      },
      "message": {
        "type": "string",
        "description": "Human-readable error description."
      }
    }
  },
  "gotchas": [
    "Only record a disbursement as successful when transfer.status is \"complete\". \"pending\" means the mobile money network has not yet confirmed delivery.",
    "This endpoint also requires the `X-Grant` header carrying your private key (`X-Grant: YOUR_PRIVATE_KEY`). Without it Notch Pay returns 403 \"This endpoint requires additional authentication\"; a wrong value returns 403 \"Invalid grant key\".",
    "Authorization takes your public key as is, with no 'Bearer ' prefix, and X-Grant your private key (Notch Pay's Authentication page: `-H \"Authorization: YOUR_PUBLIC_KEY\"` `-H \"X-Grant: YOUR_PRIVATE_KEY\"`)."
  ]
}
