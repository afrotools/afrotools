          "googlepay": {
            "type": "object",
            "properties": {
              "card_holder_name": {
                "type": "string",
                "description": "The cardholder name.",
                "pattern": "^(?![ ,.'-]*$)[A-Za-z ,.'-]{2,50}$"
              }
            }
          }
        },
        "type": "object",
        "required": [
          "type"
        ]
      },
      {
        "properties": {
          "type": {
            "type": "string",
            "description": "The type of the payment method.",
            "enum": [
              "ussd"
            ]
          },
          "customer_id": {
            "type": "string",
            "description": "ID of the customer."
          },
          "meta": {
            "$ref": "#/$defs/meta"
          },
          "ussd": {
            "type": "object",
            "required": [
              "account_bank"
