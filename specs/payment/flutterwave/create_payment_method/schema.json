            "properties": {
              "account_bank": {
                "type": "string",
                "pattern": "^\\d{3,}$",
                "description": "A valid Nigerian bank code consisting of 3 or more digits."
              }
            }
          }
        },
        "type": "object",
        "required": [
          "type",
          "ussd"
        ]
      }
    ],
    "$defs": {
      "meta": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
