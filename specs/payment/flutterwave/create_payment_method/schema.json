{
  "spec_version": "1.1",
  "provider_api_version": "v4",
  "capability": "create_payment_method",
  "capability_type": "synchronous",
  "status": "ready",
  "currency": [
    "EGP",
    "ETB",
    "GHS",
    "KES",
    "MWK",
    "NGN",
    "RWF",
    "SLL",
    "TZS",
    "UGX",
    "USD",
    "XAF",
    "XOF",
    "ZAR",
    "ZMW"
  ],
  "auth": {
    "type": "oauth2",
    "location": "header",
    "field": "Authorization",
    "format": "Bearer {access_token}",
    "env_var": "FLUTTERWAVE_CLIENT_ID",
    "credentials": [
      {
        "env_var": "FLUTTERWAVE_CLIENT_ID",
        "description": "client_id of the environment (sandbox: developer account dashboard; production: Settings → API Keys, v4)"
      },
      {
        "env_var": "FLUTTERWAVE_CLIENT_SECRET",
        "description": "client_secret of the same environment"
      },
      {
        "env_var": "FLUTTERWAVE_ENCRYPTION_KEY",
        "description": "encryption key (base64) from the API settings section of the Flutterwave dashboard, used to encrypt card data"
      }
    ],
    "token_exchange": {
      "method": "POST",
      "url": "https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token",
      "content_type": "application/x-www-form-urlencoded",
      "body": [
        {
          "name": "client_id",
          "value": "{FLUTTERWAVE_CLIENT_ID}"
        },
        {
          "name": "client_secret",
          "value": "{FLUTTERWAVE_CLIENT_SECRET}"
        },
        {
          "name": "grant_type",
          "value": "client_credentials"
        }
      ],
      "token_field": "access_token",
      "expires_in_s": 600
    },
    "apply": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {access_token}"
      }
    ]
  },
  "endpoint": {
    "method": "POST",
    "url": "https://f4bexperience.flutterwave.com/payment-methods"
  },
  "example_prompt": "Tokenise a customer's card (encrypted), mobile money wallet, USSD bank or OPay wallet as a Flutterwave payment method.",
  "input_schema": {
    "oneOf": [
      {
        "properties": {
          "type": {
            "type": "string",
            "description": "The type of the payment method.",
            "enum": [
              "card"
            ]
          },
          "customer_id": {
            "type": "string",
            "description": "ID of the customer."
          },
          "meta": {
            "$ref": "#/$defs/meta"
          },
          "card": {
            "type": "object",
            "required": [
              "encrypted_expiry_month",
              "encrypted_expiry_year",
              "encrypted_card_number",
              "nonce"
            ],
            "properties": {
              "nonce": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9]+$",
                "minLength": 12,
                "maxLength": 12,
                "description": "A single-use 12 character alphanumeric string for field-level encryption."
              },
              "encrypted_expiry_month": {
                "type": "string",
                "description": "Encrypted value of the card's expiry month.",
                "pattern": "^.+$"
              },
              "encrypted_expiry_year": {
                "type": "string",
                "description": "Encrypted value of the card's expiry year.",
                "pattern": "^.+$"
              },
              "encrypted_card_number": {
                "type": "string",
                "description": "Encrypted value of the card number.",
                "pattern": "^.+$"
              },
              "encrypted_cvv": {
                "type": "string",
                "description": "Encrypted value of the card's security code (CVV/CSC).",
                "pattern": "^.+$"
              },
              "billing_address": {
                "type": "object",
                "description": "Customer address information.",
                "required": [
                  "line1",
                  "city",
                  "state",
                  "country",
                  "postal_code"
                ],
                "properties": {
                  "city": {
                    "type": "string",
                    "description": "The name of the city.",
                    "pattern": "^.+$"
                  },
                  "country": {
                    "description": "ISO2 country code",
                    "type": "string",
                    "pattern": "^[A-Z]{2}$"
                  },
                  "line1": {
                    "type": "string",
                    "description": "The first line of the Customer's address.",
                    "pattern": "^.+$"
                  },
                  "line2": {
                    "type": "string",
                    "description": "The second line of the Customer's address.",
                    "pattern": "^.+$"
                  },
                  "postal_code": {
                    "type": "string",
                    "pattern": "^.+$"
                  },
                  "state": {
                    "type": "string",
                    "description": "The state or region.",
                    "pattern": "^.+$"
                  }
                }
              },
              "cof": {
                "type": "object",
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "description": "Set to true to enable recurring card charge with Credential-on-File (COF)."
                  },
                  "agreement_id": {
                    "type": "string",
                    "description": "A unique reference generated by Flutterwave during the initial Customer Initiated Transaction (CIT)."
                  },
                  "trace_id": {
                    "type": "string",
                    "description": "A reference generated by the card scheme during the initial Customer Initiated Transaction (CIT)."
                  }
                }
              },
              "card_holder_name": {
                "type": "string",
                "description": "Name on the card"
              }
            }
          }
        },
        "type": "object",
        "required": [
          "card",
          "type"
        ]
      },
      {
        "properties": {
          "type": {
            "type": "string",
            "description": "The type of the payment method.",
            "enum": [
              "bank_account"
            ]
          },
          "customer_id": {
            "type": "string",
            "description": "ID of the customer."
          },
          "meta": {
            "$ref": "#/$defs/meta"
          },
          "bank_account": {
            "type": "object"
          }
        },
        "type": "object",
        "required": [
          "type"
        ]
      },
      {
        "properties": {
          "type": {
            "type": "string",
            "description": "The type of the payment method.",
            "enum": [
              "mobile_money"
            ]
          },
          "customer_id": {
            "type": "string",
            "description": "ID of the customer."
          },
          "meta": {
            "$ref": "#/$defs/meta"
          },
          "mobile_money": {
            "type": "object",
            "required": [
              "network",
              "phone_number",
              "country_code"
            ],
            "properties": {
              "network": {
                "type": "string",
                "description": "The mobile network of the customer's phone number."
              },
              "country_code": {
                "type": "string",
                "pattern": "^[0-9]{1,3}$",
                "description": "The dialling country code e.g. 233 for GH."
              },
              "phone_number": {
                "type": "string",
                "pattern": "^[0-9]{7,10}$",
                "description": "Unformatted 7-10-digit phone number without the country code."
              },
              "use_qr": {
                "type": "boolean",
                "description": "flag that indicates if qr code should be used"
              }
            }
          }
        },
        "type": "object",
        "required": [
          "mobile_money",
          "type"
        ]
      },
      {
        "properties": {
