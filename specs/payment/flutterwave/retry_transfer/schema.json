  "error_schema": {
    "type": "object",
    "required": [
      "status",
      "error"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "failed"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ],
        "description": "Present on 401/403/409 bodies; the 400 body has none."
      },
      "error": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Error category. Generic: REQUEST_NOT_VALID, UNAUTHORIZED, FORBIDDEN, RESOURCE_NOT_FOUND, RESOURCE_CONFLICT, UNPROCESSABLE, INTERNAL_SERVER_ERROR; or a domain type (see code)."
          },
          "code": {
            "type": "string",
            "description": "String. Generic 10400/10401/10403/10404/10409/10422/10500, or a domain code documented for this endpoint: 404400 REQUIRES_FAILED_STATUS (retry), 401400 REQUIRES_SUCCESSFUL_STATUS (duplicate), 403400 SCHEDULED_DEFERRED_NOT_ALLOWED, 405400 POSSIBLE_DUPLICATE_RETRIES."
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "validation_errors": {
            "type": "array",
            "description": "On 400 validation errors.",
            "items": {
              "type": "object",
