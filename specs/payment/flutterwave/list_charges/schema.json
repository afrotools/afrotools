{
  "spec_version": "1.1",
  "provider_api_version": "v4",
  "capability": "list_charges",
  "capability_type": "synchronous",
  "status": "ready",
  "currency": [
    "EGP",
    "ETB",
    "GHS",
    "KES",
    "MWK",
    "NGN",
    "RWF",
    "SLL",
    "TZS",
    "UGX",
    "USD",
    "XAF",
    "XOF",
    "ZAR",
    "ZMW"
  ],
  "auth": {
    "type": "oauth2",
    "location": "header",
    "field": "Authorization",
    "format": "Bearer {access_token}",
    "env_var": "FLUTTERWAVE_CLIENT_ID",
    "credentials": [
      {
        "env_var": "FLUTTERWAVE_CLIENT_ID",
        "description": "client_id of the environment (sandbox: developer account dashboard; production: Settings → API Keys, v4)"
      },
      {
        "env_var": "FLUTTERWAVE_CLIENT_SECRET",
        "description": "client_secret of the same environment"
      }
    ],
    "token_exchange": {
      "method": "POST",
      "url": "https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token",
      "content_type": "application/x-www-form-urlencoded",
      "body": [
        {
          "name": "client_id",
          "value": "{FLUTTERWAVE_CLIENT_ID}"
        },
        {
          "name": "client_secret",
          "value": "{FLUTTERWAVE_CLIENT_SECRET}"
        },
        {
          "name": "grant_type",
          "value": "client_credentials"
        }
      ],
      "token_field": "access_token",
      "expires_in_s": 600
    },
    "apply": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {access_token}"
      }
    ]
  },
  "endpoint": {
    "method": "GET",
    "url": "https://f4bexperience.flutterwave.com/charges"
  },
  "example_prompt": "List Flutterwave charges paid into a virtual account (or by customer, status or date) to reconcile payments.",
  "input_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "description": "Query parameter. The status of the charge.",
        "enum": [
          "succeeded",
          "pending",
          "failed",
          "voided"
        ]
      },
      "reference": {
        "type": "string",
        "description": "Query parameter. A custom identifier to track the transaction, This must be unique across all your transactions."
      },
      "to": {
        "type": "string",
        "format": "date-time",
        "description": "Query parameter. The end date and time for a period. This parameter is used in conjunction with the 'from' parameter to define a time range. The value should be in **ISO 8601 format**."
      },
      "from": {
        "type": "string",
        "format": "date-time",
        "description": "Query parameter. The start date and time for a period. This parameter is used in conjunction with the 'to' parameter to define a time range. The value should be in ISO 8601 format."
      },
      "customer_id": {
        "type": "string",
        "description": "Query parameter. The customer ID"
      },
      "virtual_account_id": {
        "type": "string",
        "description": "Query parameter. The virtual account ID"
      },
      "payment_method_id": {
        "type": "string",
        "description": "Query parameter. ID of the payment method."
      },
      "order_id": {
        "type": "string",
        "description": "Query parameter. ID of the order."
      },
      "page": {
        "type": "integer",
        "minimum": 1,
        "default": 1,
        "description": "Query parameter. The page of the data to retrieve. The most recent data entry is on page 1."
      },
      "size": {
        "type": "integer",
        "minimum": 10,
        "maximum": 50,
        "default": 10,
        "description": "Query parameter. Length of data returned. Defaults to 10."
      }
    }
  },
  "response_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "success",
          "failed"
        ]
      },
      "message": {
        "type": "string"
      },
      "meta": {
        "type": "object",
        "properties": {
          "page_info": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "description": "The total number of items available across all pages",
                "format": "int64"
              },
              "current_page": {
                "type": "integer",
                "description": "The current page number being viewed",
                "format": "int64"
              },
              "total_pages": {
                "type": "integer",
                "description": "The total number of pages required to display all items.",
                "format": "int64"
              }
            }
          }
        }
      },
      "data": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "description": "ID of the charge.",
              "type": "string"
            },
            "amount": {
              "type": "number",
              "format": "decimal",
              "description": "The payment amount in decimals.",
              "minimum": 0.01
            },
            "fees": {
              "type": "array",
              "description": "Fees charged on payment amount",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "The specific type of fee. i.e., \"vat\", \"app\", \"merchant\", \"stamp_duty\"."
                  },
                  "amount": {
                    "type": "number",
                    "format": "decimal",
                    "description": "The fee amount in decimal format."
                  }
                }
              }
            },
            "billing_details": {
              "type": "object",
              "description": "The customer's billing information.",
              "properties": {
                "email": {
                  "type": "string",
                  "description": "The Customer's email address."
                },
                "name": {
                  "type": "object",
                  "description": "The Customer's full name.",
                  "properties": {
                    "first": {
                      "type": "string",
                      "description": "The Customer's first name."
                    },
                    "middle": {
                      "type": "string",
                      "description": "The Customer's middle name."
                    },
                    "last": {
                      "type": "string",
                      "description": "The Customer's last name."
                    }
                  }
                },
                "phone": {
                  "type": "object",
                  "description": "The customer's mobile number.",
                  "required": [
                    "number",
                    "country_code"
                  ],
                  "properties": {
                    "country_code": {
                      "description": "The dialling country code e.g. 234 for NG.",
                      "type": "string"
                    },
                    "number": {
                      "description": "Unformatted 7-10-digit phone number without the country code.",
                      "type": "string"
                    }
                  }
                }
              }
            },
            "currency": {
              "description": "ISO 4217 currency code. The API's currency enum has 163 codes and uses SLL for Sierra Leone, not SLE.",
              "type": "string"
            },
            "customer_id": {
              "description": "ID of the customer.",
              "type": "string"
            },
            "description": {
              "description": "The charge's description.",
              "type": "string"
            },
            "disputed": {
              "description": "Boolean indicating if the charge was disputed.",
              "type": "boolean"
            },
            "settled": {
              "description": "Boolean indicating if the transaction has been settled.",
              "type": "boolean"
            },
            "settlement_id": {
              "description": "Id for the settlement the transaction belongs to.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "meta": {
              "$ref": "#/$defs/meta"
            },
