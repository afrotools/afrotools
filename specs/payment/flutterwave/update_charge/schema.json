                    "enum": [
                      "requires_capture"
                    ]
                  },
                  "requires_capture": {
                    "type": "object"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "requires_bank_transfer"
                    ]
                  },
                  "requires_bank_transfer": {
                    "type": "object",
                    "required": [
                      "account_number",
                      "account_bank_name"
                    ],
                    "properties": {
                      "account_number": {
                        "type": "string",
                        "description": "The account number designated for receiving payments."
                      },
                      "account_bank_name": {
                        "type": "string",
                        "description": "The Bank name."
                      },
                      "account_expiration_datetime": {
                        "type": "string",
                        "description": "Specifies when the virtual account expires.",
                        "format": "date-time"
                      },
                      "note": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "qr_code",
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "qr_code"
                    ]
                  },
                  "qr_code": {
                    "type": "object",
                    "required": [
                      "image"
                    ],
                    "properties": {
                      "image": {
                        "type": "string",
                        "description": "Qr code"
                      }
                    }
                  }
                }
              }
            ]
          },
