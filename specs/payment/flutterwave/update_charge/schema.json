{
  "spec_version": "1.0",
  "provider_api_version": "v4",
  "capability": "update_charge",
  "capability_type": "synchronous",
  "status": "ready",
  "currency": [
    "EGP",
    "ETB",
    "GHS",
    "KES",
    "MWK",
    "NGN",
    "RWF",
    "SLL",
    "TZS",
    "UGX",
    "USD",
    "XAF",
    "XOF",
    "ZAR",
    "ZMW"
  ],
  "auth": {
    "type": "oauth2",
    "location": "header",
    "field": "Authorization",
    "format": "Bearer {access_token}",
    "env_var": "FLUTTERWAVE_CLIENT_CREDENTIALS"
  },
  "endpoint": {
    "method": "PUT",
    "url": "https://f4bexperience.flutterwave.com/charges/{id}"
  },
  "example_prompt": "Complete a pending Flutterwave card charge by sending the customer's encrypted PIN, then the OTP (or AVS address) the charge asks for.",
  "input_schema": {
    "type": "object",
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "description": "Path parameter. ID of the charge.",
        "type": "string"
      },
      "meta": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "authorization": {
        "oneOf": [
          {
            "type": "object",
            "description": "OTP authorization object.",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "otp"
                ]
              },
              "otp": {
                "type": "object",
                "required": [
                  "code"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{4,8}$",
                    "description": "One-time password(OTP) sent by the Bank."
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "description": "PIN authorization object.",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "pin"
                ]
              },
              "pin": {
                "type": "object",
                "description": "PIN authorization object.",
                "required": [
                  "encrypted_pin",
                  "nonce"
                ],
                "properties": {
                  "nonce": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9]+$",
                    "minLength": 12,
                    "maxLength": 12,
                    "description": "A single-use 12 character alphanumeric string for field-level encryption."
                  },
                  "encrypted_pin": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "description": "External 3DS authorization object.",
            "required": [
              "external_3ds",
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "external_3ds"
                ]
              },
              "external_3ds": {
                "type": "object",
                "required": [
                  "eci",
                  "authentication_token",
                  "transaction_id",
                  "version",
                  "transaction_status",
                  "status_reason_code",
                  "amount",
                  "time"
                ],
                "properties": {
                  "eci": {
                    "type": "string",
                    "description": "Electronic Commerce Indicator from the issuer's Access Control Server (ACS), showing the outcome of the payer's authentication attempt."
                  },
                  "time": {
                    "type": "string",
                    "description": "The time of the payer's authentication in UTC."
                  },
                  "authentication_token": {
                    "type": "string",
                    "description": "Base64 encoded value generated by the card issuer."
                  },
                  "transaction_id": {
                    "type": "string",
                    "description": "The unique transaction identifier from the Access Control Server (ACS)."
                  },
                  "version": {
                    "type": "string",
                    "description": "EMV 3D Secure protocol."
                  },
                  "transaction_status": {
                    "type": "string",
                    "description": "The status of the external authorization attempt.",
                    "enum": [
                      "Y",
                      "N",
                      "U",
                      "A",
                      "R"
                    ]
                  },
                  "status_reason_code": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number",
                    "format": "decimal",
                    "description": "The payment amount in decimals.",
                    "minimum": 0.01
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "description": "AVS authorization object.",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "avs"
                ]
              },
              "avs": {
                "type": "object",
                "required": [
                  "address"
                ],
                "properties": {
                  "address": {
                    "type": "object",
                    "description": "Customer address information.",
                    "required": [
                      "line1",
                      "city",
                      "state",
                      "country",
                      "postal_code"
                    ],
                    "properties": {
                      "city": {
                        "type": "string",
                        "description": "The name of the city.",
                        "pattern": "^.+$"
                      },
                      "country": {
                        "description": "ISO2 country code",
                        "type": "string",
                        "pattern": "^[A-Z]{2}$"
                      },
                      "line1": {
                        "type": "string",
                        "description": "The first line of the Customer's address.",
                        "pattern": "^.+$"
                      },
                      "line2": {
                        "type": "string",
                        "description": "The second line of the Customer's address.",
                        "pattern": "^.+$"
                      },
                      "postal_code": {
                        "type": "string",
                        "pattern": "^.+$"
                      },
                      "state": {
                        "type": "string",
                        "description": "The state or region.",
                        "pattern": "^.+$"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "response_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "success",
          "failed"
        ]
      },
      "message": {
        "type": "string"
      },
      "data": {
        "type": "object",
        "properties": {
          "id": {
            "description": "ID of the charge.",
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "decimal",
            "description": "The payment amount in decimals.",
            "minimum": 0.01
          },
          "fees": {
            "type": "array",
            "description": "Fees charged on payment amount",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "The specific type of fee. i.e., \"vat\", \"app\", \"merchant\", \"stamp_duty\"."
                },
                "amount": {
                  "type": "number",
                  "format": "decimal",
                  "description": "The fee amount in decimal format."
                }
              }
            }
          },
          "billing_details": {
            "type": "object",
            "description": "The customer's billing information.",
            "properties": {
              "email": {
                "type": "string",
                "description": "The Customer's email address."
              },
              "name": {
                "type": "object",
                "description": "The Customer's full name.",
                "properties": {
                  "first": {
                    "type": "string",
                    "description": "The Customer's first name."
                  },
                  "middle": {
                    "type": "string",
                    "description": "The Customer's middle name."
                  },
                  "last": {
                    "type": "string",
                    "description": "The Customer's last name."
                  }
                }
              },
              "phone": {
                "type": "object",
                "description": "The customer's mobile number.",
                "required": [
                  "number",
                  "country_code"
                ],
                "properties": {
                  "country_code": {
                    "description": "The dialling country code e.g. 234 for NG.",
                    "type": "string"
                  },
                  "number": {
                    "description": "Unformatted 7-10-digit phone number without the country code.",
                    "type": "string"
                  }
                }
              }
            }
          },
          "currency": {
            "description": "ISO 4217 currency code. The API's currency enum has 163 codes and uses SLL for Sierra Leone, not SLE.",
            "type": "string"
          },
          "customer_id": {
            "description": "ID of the customer.",
            "type": "string"
          },
          "description": {
            "description": "The charge's description.",
            "type": "string"
          },
          "disputed": {
            "description": "Boolean indicating if the charge was disputed.",
            "type": "boolean"
          },
          "settled": {
            "description": "Boolean indicating if the transaction has been settled.",
            "type": "boolean"
          },
          "settlement_id": {
            "description": "Id for the settlement the transaction belongs to.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "meta": {
            "$ref": "#/$defs/meta"
          },
          "next_action": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "redirect_url",
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "redirect_url"
                    ]
                  },
                  "redirect_url": {
                    "type": "object",
                    "required": [
                      "url"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "Payment screen URL to redirect customer to."
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "requires_additional_fields",
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "requires_additional_fields"
                    ]
                  },
                  "requires_additional_fields": {
                    "type": "object",
                    "required": [
                      "fields"
                    ],
                    "properties": {
                      "fields": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "requires_pin"
                    ]
                  },
                  "requires_pin": {
                    "type": "object"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "requires_requery"
                    ]
                  },
                  "requires_requery": {
                    "type": "object"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "requires_otp"
                    ]
                  },
                  "requires_otp": {
                    "type": "object"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "payment_instruction",
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "payment_instruction"
                    ]
                  },
                  "payment_instruction": {
                    "type": "object",
                    "required": [
                      "note"
                    ],
                    "properties": {
                      "note": {
                        "type": "string",
                        "description": "Custom field containing the payment instruction."
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": [
