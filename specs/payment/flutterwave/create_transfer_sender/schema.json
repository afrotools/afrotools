  "capability": "create_transfer_sender",
  "capability_type": "synchronous",
  "status": "ready",
  "currency": [
    "EGP",
    "ETB",
    "GHS",
    "KES",
    "MWK",
    "NGN",
    "RWF",
    "SLL",
