  "auth": {
    "type": "oauth2",
    "location": "header",
    "field": "Authorization",
    "format": "Bearer {access_token}",
    "env_var": "FLUTTERWAVE_CLIENT_ID",
    "credentials": [
      {
        "env_var": "FLUTTERWAVE_CLIENT_ID",
        "description": "client_id of the environment (sandbox: developer account dashboard; production: Settings → API Keys, v4)"
      },
      {
        "env_var": "FLUTTERWAVE_CLIENT_SECRET",
        "description": "client_secret of the same environment"
      }
    ],
    "token_exchange": {
      "method": "POST",
      "url": "https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token",
      "content_type": "application/x-www-form-urlencoded",
      "body": [
        {
          "name": "client_id",
          "value": "{FLUTTERWAVE_CLIENT_ID}"
        },
        {
          "name": "client_secret",
          "value": "{FLUTTERWAVE_CLIENT_SECRET}"
        },
        {
          "name": "grant_type",
          "value": "client_credentials"
        }
      ],
      "token_field": "access_token",
      "expires_in_s": 600
    },
    "apply": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "Bearer {access_token}"
      }
    ]
  },
  "endpoint": {
    "method": "POST",
    "url": "https://f4bexperience.flutterwave.com/transfers/senders"
