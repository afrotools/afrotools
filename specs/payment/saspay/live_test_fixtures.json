{
  "steps": [
    {
      "capability": "create_payment",
      "body": {
        "amount": "2500.00",
        "currency": "XOF",
        "country": "BJ",
        "network": "mtn_bj",
        "customer": {
          "email": "live-$ts@example.com",
          "phone": "+2290197234560",
          "last_name": "Sossou",
          "first_name": "Awa"
        },
        "description": "afro.tools live test"
      },
      "headers": { "Idempotency-Key": "$uuid" },
      "store_as": "payment"
    },
    {
      "capability": "verify_payment",
      "path_params": { "payment_id": "$payment.data.id" },
      "wait_seconds": 3
    },
    {
      "capability": "create_checkout_session",
      "body": {
        "amount": "1500.00",
        "currency": "XOF",
        "customer_email": "live-$ts@example.com",
        "customer_name": "Awa Sossou",
        "return_url": "https://example.com/return",
        "description": "afro.tools live test"
      },
      "store_as": "checkout"
    },
    {
      "capability": "get_checkout_session_status",
      "path_params": { "id": "$checkout.data.id" }
    },
    {
      "capability": "cancel_checkout_session",
      "path_params": { "id": "$checkout.data.id" }
    },
    {
      "capability": "create_payment_link",
      "body": {
        "name": "afro.tools live test $ts",
        "currency": "XOF",
        "amount": "500.00",
        "amount_type": "FIXED"
      },
      "store_as": "link"
    },
    {
      "capability": "send_payout",
      "body": {
        "amount": "10000.00",
        "currency": "XAF",
        "country": "CM",
        "method": "mtn_cm",
        "customer": {
          "email": "client@example.com",
          "phone": "+22997505050",
          "last_name": "Sossou",
          "first_name": "Awa"
        },
        "recipient": { "msisdn": "677889900" },
        "description": "afro.tools live test"
      },
      "headers": { "Idempotency-Key": "$uuid" },
      "acceptable_error_codes": ["payout_not_enabled", "ip_not_whitelisted"],
      "store_as": "payout"
    }
  ]
}
