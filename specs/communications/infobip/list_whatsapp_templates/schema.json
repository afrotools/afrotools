{
  "spec_version": "1.1",
  "provider_api_version": "3.255.0",
  "capability": "list_whatsapp_templates",
  "capability_type": "synchronous",
  "status": "ready",
  "auth": {
    "type": "api_key",
    "location": "header",
    "field": "Authorization",
    "format": "App {token}",
    "env_var": "INFOBIP_API_KEY",
    "credentials": [
      {
        "env_var": "INFOBIP_API_KEY",
        "description": "API key (Authorization: App <key>); keys have an expiry date and can be revoked"
      },
      {
        "env_var": "INFOBIP_BASE_URL",
        "description": "your account's base URL, https://xxxxx.api.infobip.com, shown in the Infobip API Resource hub — it identifies the account, the key authenticates it"
      }
    ],
    "apply": [
      {
        "in": "header",
        "name": "Authorization",
        "value": "App {INFOBIP_API_KEY}"
      }
    ]
  },
  "endpoint": {
    "url": "https://xxxxx.api.infobip.com/whatsapp/1/templates",
    "method": "GET"
  },
  "example_prompt": "List the WhatsApp templates on my Infobip account (filter by sender, status, name or language) before sending a template message.",
