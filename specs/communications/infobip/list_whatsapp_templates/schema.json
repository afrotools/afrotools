                  "properties": {
                    "category": {
                      "const": "AUTHENTICATION"
                    }
                  },
                  "required": [
                    "category"
                  ]
                }
              ]
            }
          ],
          "description": "The list of the results for this page."
        }
      },
      "paging": {
        "type": "object",
        "description": "Contains information about the page.",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int32",
