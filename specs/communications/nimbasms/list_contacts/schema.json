{
  "spec_version": "1.1",
  "provider_api_version": "2024-01-01",
  "capability": "list_contacts",
  "capability_type": "synchronous",
  "status": "ready",
  "currency": [
    "GNF"
  ],
  "auth": {
    "type": "basic",
    "location": "header",
    "field": "Authorization",
    "format": "Basic {base64(NIMBASMS_SERVICE_ID:NIMBASMS_SECRET_TOKEN)}",
    "env_var": "NIMBASMS_SERVICE_ID",
    "credentials": [
      {
        "env_var": "NIMBASMS_SERVICE_ID",
        "description": "service ID — the user part of HTTP Basic auth, base64(SERVICE_ID:SECRET_TOKEN)"
      },
      {
        "env_var": "NIMBASMS_SECRET_TOKEN",
        "description": "secret token — the password part of HTTP Basic auth"
      }
    ]
  },
  "endpoint": {
    "method": "GET",
    "url": "https://api.nimbasms.com/v1/contacts"
  },
  "parameters": [
    {
      "name": "limit",
      "in": "query",
      "schema": {
        "type": "integer"
      },
      "description": "Maximum number of contacts to return."
    },
    {
      "name": "offset",
      "in": "query",
      "schema": {
        "type": "integer"
      },
      "description": "Pagination offset."
    }
  ],
  "example_prompt": "List contacts in my NimbaSMS address book.",
  "input_schema": {
    "type": "object",
    "properties": {}
  },
  "response_schema": {
    "type": "object",
    "properties": {
      "count": {
        "type": "integer",
        "description": "Total number of contacts."
      },
      "next": {
        "type": [
          "string",
          "null"
        ],
        "description": "URL of the next page, or null."
      },
      "previous": {
        "type": [
          "string",
          "null"
        ],
        "description": "URL of the previous page, or null."
      },
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "numero": {
              "type": "string",
              "description": "Contact's phone number."
            },
            "name": {
              "type": "string",
              "description": "Contact name."
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Groups the contact belongs to."
            }
          }
        }
      }
    }
  },
  "error_schema": {
    "type": "object",
    "properties": {
      "detail": {
        "type": "string",
        "description": "General error (e.g. 401 unauthorized)."
      }
    }
  },
  "gotchas": [
    "The response is paginated. Use 'limit' and 'offset' to navigate between pages — the 'next' field contains the full URL of the next page.",
    "The NimbaSMS SDK strips the 'count', 'next', 'previous' fields from the response and returns only 'results'. When calling the API directly, the raw response contains all of these fields."
  ],
  "open_questions": [
    "Sandbox: provider.json declares none and no gotcha documents a test environment — every call reaches production."
  ]
}
