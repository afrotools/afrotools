{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/afrotools/afrotools/blob/main/atss.schema.json",
  "title": "ATSS 1.1 — capability blocks added in 1.1",
  "description": "Validated by scripts/validate.js on every schema.json ($defs/environments and $defs/removed_capabilities on provider.json). The 1.0 fields are checked by validate.js itself; see ATSS.md for every rule.",
  "type": "object",
  "properties": {
    "verification": { "$ref": "#/$defs/verification" },
    "deprecation": {
      "description": "Present when status is \"deprecated\": what the provider announced (ATSS.md § Compatibility policy).",
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "pattern": "\\S" },
        "replaced_by": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "removed_after": { "type": "string", "format": "date" }
      }
    },
    "open_questions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "\\S" }
    },
    "parameters": {
      "description": "Request parameters outside the body (input_schema is the body): path, query and header.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "in", "schema"],
        "properties": {
          "name": { "type": "string", "pattern": "\\S" },
          "in": { "enum": ["path", "query", "header"] },
          "required": { "type": "boolean" },
          "description": { "type": "string", "pattern": "\\S" },
          "schema": { "type": "object" }
        }
      }
    },
    "success_condition": {
      "description": "When a 2xx response is not enough: the response field that says the call succeeded.",
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "oneOf": [{ "required": ["equals"] }, { "required": ["in"] }],
      "properties": {
        "field": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$" },
        "equals": { "type": ["string", "number", "boolean", "null"] },
        "in": { "type": "array", "minItems": 1, "items": { "type": ["string", "number", "boolean", "null"] } }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "credentials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["env_var", "description"],
            "properties": {
              "env_var": { "$ref": "#/$defs/env_var" },
              "description": { "type": "string", "pattern": "\\S" }
            }
          }
        },
        "signing": { "type": "object", "$ref": "#/$defs/hmac", "unevaluatedProperties": false },
        "token_exchange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "token_field"],
          "oneOf": [{ "required": ["path"] }, { "required": ["url"] }],
          "dependentRequired": { "body": ["content_type"], "content_type": ["body"] },
          "if": { "properties": { "method": { "const": "GET" } } },
          "then": { "not": { "required": ["body"] } },
          "properties": {
            "method": { "enum": ["GET", "POST"] },
            "path": { "type": "string", "pattern": "^/" },
            "url": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?/" },
            "content_type": { "enum": ["application/x-www-form-urlencoded"] },
            "body": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "value"],
                "properties": {
                  "name": { "type": "string", "pattern": "\\S" },
                  "value": { "$ref": "#/$defs/template" }
                }
              }
            },
            "headers": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/apply/items", "properties": { "in": { "const": "header" } } }
            },
            "token_field": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" },
            "expires_in_s": { "type": "integer", "minimum": 1 }
          }
        },
        "apply": { "$ref": "#/$defs/apply" }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature"],
      "properties": {
        "signature": {
          "type": "object",
          "allOf": [{ "$ref": "#/$defs/hmac" }],
          "required": ["header", "format"],
          "properties": {
            "header": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
            "key": { "type": "string", "pattern": "^\\{[A-Z][A-Z0-9_]*\\}$" },
            "format": { "type": "string", "pattern": "\\{signature\\}" }
          },
          "unevaluatedProperties": false
        }
      }
    }
  },
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "environment", "at", "spec_hash"],
      "properties": {
        "method": { "enum": ["test_live", "app", "community_report"] },
        "environment": { "enum": ["sandbox", "production"] },
        "at": { "type": "string", "format": "date" },
        "ref": { "type": "string", "pattern": "\\S" },
        "spec_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "if": { "properties": { "method": { "const": "community_report" } } },
      "then": {
        "required": ["ref"],
        "properties": { "ref": { "type": "string", "pattern": "^https://github\\.com/afrotools/afrotools/issues/[0-9]+$" } }
      }
    },
    "removed_capabilities": {
      "description": "provider.json: tombstones of the capabilities removed after a provider deprecation.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "removed_in", "reason"],
        "properties": {
          "capability": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "removed_in": { "type": "string", "format": "date" },
          "reason": { "type": "string", "pattern": "\\S" },
          "alternatives": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
        }
      }
    },
    "env_var": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "template": {
      "description": "Text with {placeholders}: a credential's env var, {signature}, {access_token}; in webhook.signature.message also {raw_body}, {header:Name} and an env var the example reads.",
      "type": "string",
      "pattern": "\\S"
    },
    "hmac": {
      "type": "object",
      "required": ["algorithm", "key", "message", "encoding"],
      "properties": {
        "algorithm": { "enum": ["HMAC-SHA256"] },
        "key": { "$ref": "#/$defs/template" },
        "message": { "$ref": "#/$defs/template" },
        "encoding": { "enum": ["hex", "base64"] }
      }
    },
    "apply": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["in", "name", "value"],
        "properties": {
          "in": { "enum": ["header", "query", "body", "path"] },
          "name": { "type": "string", "pattern": "\\S" },
          "value": { "$ref": "#/$defs/template" }
        }
      }
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "sandbox": { "$ref": "#/$defs/environment" },
        "production": { "$ref": "#/$defs/environment" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url"],
      "properties": {
        "base_url": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?$" }
      }
    }
  }
}
