{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/afrotools/afrotools/blob/main/atss.schema.json",
  "title": "ATSS 1.1 — capability blocks added in 1.1",
  "description": "Validated by scripts/validate.js on every schema.json. The 1.0 fields are checked by validate.js itself; see ATSS.md for every rule.",
  "type": "object",
  "properties": {
    "verification": { "$ref": "#/$defs/verification" },
    "open_questions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "\\S" }
    }
  },
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "environment", "at", "spec_hash"],
      "properties": {
        "method": { "enum": ["test_live", "app", "community_report"] },
        "environment": { "enum": ["sandbox", "production"] },
        "at": { "type": "string", "format": "date" },
        "ref": { "type": "string", "pattern": "\\S" },
        "spec_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "if": { "properties": { "method": { "const": "community_report" } } },
      "then": {
        "required": ["ref"],
        "properties": { "ref": { "pattern": "^https://github\\.com/afrotools/afrotools/issues/[0-9]+$" } }
      }
    }
  }
}
